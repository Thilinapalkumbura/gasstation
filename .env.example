# ─────────────────────────────────────────────────────────────────────────────
# Gasstation — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://gasstation:gasstation_dev_2024@localhost:5432/gasstation?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://:gasstation_redis_2024@localhost:6379"

# ── JWT Secrets — CHANGE THESE IN PRODUCTION ─────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION_DIFFERENT_FROM_ACCESS_SECRET_MIN_64_CHARS

# Token expiry
JWT_ACCESS_EXPIRES_IN_SECONDS=900      # 15 minutes
JWT_REFRESH_EXPIRES_IN_DAYS=30         # 30 days

# ── Frontend ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
