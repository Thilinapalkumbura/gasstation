# ─────────────────────────────────────────────────────────────────────────────
# Gasstation — Production Environment (IP-based, no domain)
# Copy this file to .env on your VPS and fill in all values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server IP ─────────────────────────────────────────────────────────────────
# Replace with your actual VPS public IP address
CLIENT_URL=http://YOUR_VPS_IP

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=gasstation
POSTGRES_USER=gasstation
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_FOR_ACCESS_TOKEN
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_DIFFERENT_FROM_ABOVE

# ── Token expiry ──────────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_DAYS=30
